(function () {
  const config = {
    numeroInicial: 20109717,
    fechaInicio: new Date("2025-08-01T05:00:00Z"),
    crecimientoBasePorHora: 208,
    paises: ["MY", "PE", "BO", "MX", "IN", "PH", "TH"]
  };

  let ejecutado = false;

  function cargarBanderas() {
    const contenedor = document.getElementById("dxn-flags-container");
    if (!contenedor || contenedor.children.length > 0) return;
    const tamano = window.innerWidth <= 768 ? "28px" : "34px";
    config.paises.forEach(pais => {
      const img = document.createElement("img");
      img.src = `https://flagcdn.com/w40/${pais.toLowerCase()}.png`;
      img.alt = `Bandera ${pais}`;
      img.style.width = tamano;
      img.style.height = "auto";
      img.style.borderRadius = "3px";
      img.style.boxShadow = "0 2px 4px rgba(0,0,0,0.15)";
      contenedor.appendChild(img);
    });
  }

  function iniciarContador() {
    const ahora = new Date();
    const fechaAjustada = new Date(ahora.getTime() + 5 * 60 * 60 * 1000);
    const meses = (fechaAjustada.getFullYear() - config.fechaInicio.getUTCFullYear()) * 12 + (fechaAjustada.getUTCMonth() - config.fechaInicio.getUTCMonth());
    const tasa = config.crecimientoBasePorHora + meses;
    const valorFinal = Math.floor(config.numeroInicial + ((fechaAjustada - config.fechaInicio) / 3600000) * tasa);
    const contenedor = document.getElementById("dxn-counter-float");
    if (!contenedor) return;

    let actual = valorFinal - 1000;
    const paso = Math.ceil((valorFinal - actual) / 30);

    const intervalo = setInterval(() => {
      actual = Math.min(actual + paso, valorFinal);
      contenedor.innerHTML = "";
      actual.toString().split("").forEach(digito => {
        const span = document.createElement("span");
        span.textContent = digito;
        contenedor.appendChild(span);
      });
      if (actual >= valorFinal) clearInterval(intervalo);
    }, 40);
  }

  function activar() {
    if (ejecutado) return;
    ejecutado = true;
    cargarBanderas();
    iniciarContador();
  }

  function comprobar() {
    const box = document.getElementById("dxn-floating-counter");
    if (!box || ejecutado) return;

    const rect = box.getBoundingClientRect();
    const altoPantalla = window.innerHeight || document.documentElement.clientHeight;

    if (rect.top < altoPantalla && rect.bottom > 0) {
      activar();
    }
  }

  window.addEventListener("scroll", comprobar);
  window.addEventListener("resize", comprobar);
  setTimeout(comprobar, 200);
})();
